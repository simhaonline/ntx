def parse_line_range(summary):
    if not summary:
        return (None, None)
    s = str(summary).lower()
    for prefix in ["lines ", "line "]:
        if prefix in s:
            s = s[s.find(prefix) + len(prefix):]
            break
    parts = s.split("-")
    try:
        if len(parts) == 2:
            return (int(parts[0].strip()), int(parts[1].strip()))
        elif len(parts) == 1 and parts[0].strip().isdigit():
            v = int(parts[0].strip())
            return (v, v)
    except ValueError:
        pass
    return (None, None)

def file_activity_scope_label(prev_start, prev_end, curr_start, curr_end):
    if prev_start is not None and prev_end is not None and curr_start is not None and curr_end is not None:
        if prev_start <= curr_end and curr_start <= prev_end:
            return "overlapping lines"
        return "same file, non-overlapping lines"
    return "same file"

def validate_swarm_tldr(body, tldr=None):
    MAX_SWARM_TLDR_CHARS = 200
    SWARM_TLDR_REQUIRED_OVER_CHARS = 240
    if tldr and tldr.strip():
        collapsed = " ".join(tldr.split())
        return collapsed[:MAX_SWARM_TLDR_CHARS]
    if body and len(body) > SWARM_TLDR_REQUIRED_OVER_CHARS:
        collapsed = " ".join(body.split())
        if len(collapsed) > MAX_SWARM_TLDR_CHARS:
            return collapsed[:MAX_SWARM_TLDR_CHARS - 1] + "…"
        return collapsed
    return None

def derive_swarm_task_label(text):
    MAX_SWARM_TASK_LABEL_CHARS = 48
    if not text:
        return "unnamed-task"
    for line in text.splitlines():
        line = line.strip().lstrip("#-* >").rstrip(":").strip()
        if line:
            collapsed = " ".join(line.split())
            if len(collapsed) <= MAX_SWARM_TASK_LABEL_CHARS:
                return collapsed
            return collapsed[:MAX_SWARM_TASK_LABEL_CHARS - 1] + "…"
    return "unnamed-task"

def cmd_swarm(args):
    action = args.action
    con = get_db(write=(action in ("init", "spawn", "touch", "msg")))
    now = datetime.now(timezone.utc).isoformat()
    if action == "init":
        swarm_id = getattr(args, "swarm_id", None) or f"swarm_{int(time.time())}"
        print(f"[SWARM] Initialized new swarm coordinator group: {swarm_id}")
        audit_event("swarm.init", swarm_id)
        if args.json:
            print(json.dumps({"swarm_id": swarm_id, "status": "initialized", "created_at": now}))
    elif action == "spawn":
        session_id = args.session_id or f"sess_{int(time.time())}"
        swarm_id = getattr(args, "swarm_id", "default_swarm") or "default_swarm"
        role = getattr(args, "role", "agent") or "agent"
        prompt_text = getattr(args, "prompt", "") or ""
        task_label = derive_swarm_task_label(prompt_text)
        report_back_to = getattr(args, "parent", None)
        with con:
            con.execute("""
                INSERT INTO swarm_members (session_id, swarm_id, role, status, task_label, report_back_to, created_at, updated_at)
                VALUES (?, ?, ?, 'running', ?, ?, ?, ?)
                ON CONFLICT(session_id) DO UPDATE SET
                    swarm_id=excluded.swarm_id,
                    role=excluded.role,
                    status=excluded.status,
                    task_label=excluded.task_label,
                    updated_at=excluded.updated_at
            """, (session_id, swarm_id, role, task_label, report_back_to, now, now))
        print(f"[SPAWN] Session '{session_id}' registered in swarm '{swarm_id}'")
        print(f"        Role       : {role}")
        print(f"        Task Label : {task_label}")
        if report_back_to:
            print(f"        Reports To : {report_back_to}")
        audit_event("swarm.spawn", session_id, details={"swarm_id": swarm_id, "role": role, "task_label": task_label})
    elif action == "touch":
        session_id = args.session_id
        path_str = str(Path(args.path).resolve())
        touch_action = getattr(args, "touch_action", "read") or "read"
        lines_str = getattr(args, "lines", None)
        l_start, l_end = parse_line_range(lines_str)
        swarm_id = getattr(args, "swarm_id", "default_swarm") or "default_swarm"
        summary = lines_str or ("all lines" if l_start is None else f"{l_start}-{l_end}")

        # Check for conflicts / code shifting with peer sessions
        cur = con.execute("""
            SELECT session_id, action, line_start, line_end, touched_at
            FROM swarm_touches
            WHERE path = ? AND session_id != ?
            ORDER BY id DESC LIMIT 5
        """, (path_str, session_id))
        conflicts = []
        for r in cur.fetchall():
            peer_sess = r["session_id"]
            peer_action = r["action"]
            peer_start = r["line_start"]
            peer_end = r["line_end"]
            scope = file_activity_scope_label(peer_start, peer_end, l_start, l_end)
            if touch_action == "write" or peer_action == "write":
                conflicts.append({
                    "peer_session": peer_sess,
                    "peer_action": peer_action,
                    "scope": scope,
                    "peer_range": f"{peer_start}-{peer_end}" if peer_start else "full file"
                })

        with con:
            con.execute("""
                INSERT INTO swarm_touches (session_id, swarm_id, path, action, line_start, line_end, summary, touched_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """, (session_id, swarm_id, path_str, touch_action, l_start, l_end, summary, now))
            if conflicts and touch_action == "write":
                for c in conflicts:
                    if c["scope"] == "overlapping lines":
                        adv_body = f"Code shifting advisory: Session '{session_id}' wrote lines {summary} of {path_str}. Review diff before committing."
                        adv_tldr = f"Peer edit alert: {Path(path_str).name} lines {summary}"
                        con.execute("""
                            INSERT INTO swarm_messages (swarm_id, from_session, to_target, channel, body, tldr, created_at)
                            VALUES (?, ?, ?, 'conflict-advisory', ?, ?, ?)
                        """, (swarm_id, session_id, c["peer_session"], adv_body, adv_tldr, now))

        print(f"[TOUCH] Session '{session_id}' -> {touch_action.upper()} {path_str} (Lines: {summary})")
        if conflicts:
            print("  Intervention Mode: Advisory (non-blocking alert recorded and dispatched to peer)")
            for c in conflicts:
                if c["scope"] == "overlapping lines":
                    print(f"  [ALERT] Code shifting under feet of Session '{c['peer_session']}'!")
                    print(f"          Overlap detected on {path_str} (Scope: {c['scope']})")
                else:
                    print(f"  [NOTICE] Concurrent access with Session '{c['peer_session']}' (Scope: {c['scope']})")
        else:
            print("  Status: Clean, zero peer conflicts detected.")
        audit_event("swarm.touch", session_id, details={"path": path_str, "action": touch_action, "conflicts": len(conflicts), "intervention_mode": "advisory"})
    elif action == "msg":
        from_sess = args.session_id
        target = getattr(args, "target", "*") or "*"
        channel = getattr(args, "channel", "general") or "general"
        body = args.body or ""
        swarm_id = getattr(args, "swarm_id", "default_swarm") or "default_swarm"
        tldr = validate_swarm_tldr(body, getattr(args, "tldr", None))

        with con:
            con.execute("""
                INSERT INTO swarm_messages (swarm_id, from_session, to_target, channel, body, tldr, created_at)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            """, (swarm_id, from_sess, target, channel, body, tldr, now))

        print(f"[SWARM MSG] [{channel}] {from_sess} -> {target}")
        if tldr:
            print(f"  TLDR: {tldr}")
        print(f"  Body: {body[:140]}{'...' if len(body) > 140 else ''}")
        audit_event("swarm.msg", from_sess, details={"to": target, "channel": channel, "tldr": bool(tldr)})
    elif action == "status":
        print("Swarm Active State & Member Registry:")
        print("=" * 80)
        cur = con.execute("SELECT session_id, swarm_id, role, status, task_label, updated_at FROM swarm_members ORDER BY updated_at DESC")
        members = cur.fetchall()
        if not members:
            print("  No active swarm members registered.")
        else:
            for m in members:
                print(f"  [{m['swarm_id']}] {m['session_id']:<20} Role: {m['role']:<12} Status: {m['status']:<10} Task: {m['task_label']}")
        print()
        print("Recent File Touches & Overlaps:")
        tcur = con.execute("SELECT session_id, action, path, summary, touched_at FROM swarm_touches ORDER BY id DESC LIMIT 5")
        touches = tcur.fetchall()
        if not touches:
            print("  No file touches recorded.")
