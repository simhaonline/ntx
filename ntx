def load_host_env():
    """Loads host environment variables from /root/install/install.env if present."""
    env_file = Path("/root/install/install.env")
    if env_file.exists():
        try:
            for line in env_file.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                try:
                    tokens = shlex.split(line, comments=True)
                    for token in tokens:
                        if "=" in token:
                            k, v = token.split("=", 1)
                            k = k.strip()
                            v = v.strip()
                            if k and k not in os.environ:
                                os.environ[k] = v
                except Exception:
                    if "#" in line:
                        line = line.split("#", 1)[0].strip()
                    if "=" in line:
                        k, v = line.split("=", 1)
                        k = k.strip()
                        v = v.strip().strip("'").strip('"')
                        if k and k not in os.environ:
                            os.environ[k] = v
        except Exception:
            pass

