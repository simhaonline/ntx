# --- Rapid Multi-File Editing Engine (Aider/Cursor Block Matching) ---
def cmd_edit(args):
    action = getattr(args, "action", "patch") or "patch"
    file_arg = getattr(args, "file", None)
    if not file_arg:
        print("Error: File path required for edit. Usage: ntx edit patch <file> [--content <patch>]", file=sys.stderr)
        sys.exit(1)
    file_path = Path(file_arg)
    if not file_path.is_absolute():
        file_path = Path.cwd() / file_path

    if action == "patch":
        content = getattr(args, "content", None)
        if not content and not sys.stdin.isatty():
            content = sys.stdin.read()
        if not content:
            print("Error: Patch content required (via --content or stdin).", file=sys.stderr)
            sys.exit(1)
        
        block_pattern = re.compile(
            r"<<<<<<<\s*SEARCH\r?\n(.*?)\r?\n=======\r?\n(.*?)\r?\n>>>>>>>\s*REPLACE",
            re.DOTALL
        )
        matches = list(block_pattern.finditer(content))
        orig_text = file_path.read_text(encoding="utf-8")
        current_text = orig_text
        applied = 0
        if matches:
            for m in matches:
                s_blk = m.group(1)
                r_blk = m.group(2)
                if s_blk in current_text:
                    current_text = current_text.replace(s_blk, r_blk, 1)
                    applied += 1
                else:
                    print(f"Error: Search block not matched in {file_path}", file=sys.stderr)
                    sys.exit(1)
        else:
            search_str = getattr(args, "search", None)
            replace_str = getattr(args, "replace", "")
            if search_str and search_str in current_text:
                current_text = current_text.replace(search_str, replace_str, 1)
                applied += 1
            else:
                print("Error: No matching <<<<<<< SEARCH ... ======= ... >>>>>>> REPLACE blocks found.", file=sys.stderr)
                sys.exit(1)

        snapshot_dir = Path("/var/lib/nityaksha/snapshots")
        snapshot_dir.mkdir(parents=True, exist_ok=True)
        snap_file = snapshot_dir / f"{file_path.name}.{int(time.time())}.bak"
        snap_file.write_text(orig_text, encoding="utf-8")
        file_path.write_text(current_text, encoding="utf-8")

        res = {"status": "applied", "file": str(file_path), "blocks_applied": applied, "snapshot": str(snap_file)}
        if getattr(args, "json", False):
            print(json.dumps(res, indent=2))
        else:
            print(f"[PATCH APPLIED] Successfully patched {file_path.name} ({applied} blocks)")
            print(f"  Snapshot Backup: {snap_file}")
            print(f"  Rollback Command: ntx edit rollback {file_path}")
    elif action == "rollback":
        snapshot_dir = Path("/var/lib/nityaksha/snapshots")
        snaps = sorted(snapshot_dir.glob(f"{file_path.name}.*.bak"))
        if not snaps:
            print(f"Error: No snapshot backups found for {file_path.name}", file=sys.stderr)
            sys.exit(1)
        latest = snaps[-1]
        shutil.copy2(latest, file_path)
        res = {"status": "rolled_back", "file": str(file_path), "restored_from": str(latest)}
        if getattr(args, "json", False):
            print(json.dumps(res, indent=2))
        else:
            print(f"[ROLLBACK COMPLETE] Restored {file_path.name} from {latest.name}")

