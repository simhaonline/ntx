def audit_event(action: str, target: str, actor: str = None, details: dict = None, status: str = "success"):
    ts = datetime.now(timezone.utc).isoformat()
    actor_str = actor or os.getenv("USER", "unknown")
    det = details or {}
    try:
        con = get_db(write=True)
        with con:
            con.execute(
                "INSERT INTO audit_events (timestamp, action, target, actor, status, details) VALUES (?, ?, ?, ?, ?, ?)",
                (ts, action, target, actor_str, status, json.dumps(det))
            )
    except Exception:
        pass

    try:
        AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)
        rec = {
            "timestamp": ts,
            "action": action,
            "target": target,
            "actor": actor_str,
            "status": status,
            "details": det
        }
        with open(AUDIT_LOG, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec) + "\n")
    except Exception:
        pass

def sync_catalog_to_db():
    try:
        if not DB_PATH.parent.exists() or not os.access(str(DB_PATH.parent), os.W_OK):
            return
        con = get_db(write=True)
        if CATALOG_PATH.exists():
            for kind_dir in CATALOG_PATH.iterdir():
                if kind_dir.is_dir():
                    kind = kind_dir.name.rstrip("s")
                    for yf in kind_dir.glob("*.yaml"):
                        if yf.stem == "" or yf.name == ".yaml":
                            continue
                        manifest = parse_simple_yaml(yf)
                        name = manifest.get("name") or yf.stem
                        name = name.strip()
                        if not name or name in (".", "-"):
                            continue
                        ver = manifest.get("version", "1.0.0")
                        desc = manifest.get("description", "")
                        ns = manifest.get("namespace", DEFAULT_PROJECT)
                        cid = f"{kind}:{name}"
                        sha = hashlib.sha256(yf.read_bytes()).hexdigest()
                        try:
                            with con:
                                con.execute("""
                                    INSERT INTO capabilities (id, namespace, kind, name, version, description, manifest_path, content_sha256, created_at)
                                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, datetime('now'))
                                    ON CONFLICT(namespace, kind, name) DO UPDATE SET
                                        version=excluded.version,
                                        description=excluded.description,
                                        manifest_path=excluded.manifest_path,
                                        content_sha256=excluded.content_sha256
                                """, (cid, ns, kind, name, ver, desc, str(yf), sha))
                        except Exception:
                            pass
    except Exception:
        pass

