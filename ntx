def execute_dynamic_tool(tool_name: str, args_dict: dict, workspace: Path = Path.cwd()) -> dict:
    if tool_name == "fs_read":
        p = Path(args_dict.get("path", "."))
        if not p.is_absolute():
            p = workspace / p
        if not p.exists():
            return {"error": f"File not found: {p}"}
        content = p.read_text(encoding="utf-8")
        lines = args_dict.get("lines")
        if lines:
            parts = [int(x) for x in lines.split("-")]
            all_lines = content.splitlines()
            s = max(0, parts[0] - 1)
            e = parts[1] if len(parts) > 1 else s + 50
            content = "\n".join(all_lines[s:e])
        return {"status": "ok", "path": str(p), "content": content}
    elif tool_name == "fs_write":
        p = Path(args_dict["path"])
        if not p.is_absolute():
            p = workspace / p
        p.parent.mkdir(parents=True, exist_ok=True)
        content = args_dict.get("content", "")
        p.write_text(content, encoding="utf-8")
        return {"status": "ok", "path": str(p), "bytes_written": len(content)}
    elif tool_name == "fs_patch":
        p = Path(args_dict["path"])
        if not p.is_absolute():
            p = workspace / p
        search_txt = args_dict.get("search", "")
        replace_txt = args_dict.get("replace", "")
        orig = p.read_text(encoding="utf-8")
        if search_txt not in orig:
            return {"error": f"Search target not found in {p}"}
        updated = orig.replace(search_txt, replace_txt, 1)
        p.write_text(updated, encoding="utf-8")
        return {"status": "ok", "path": str(p), "patched": True}
    elif tool_name == "sh_exec":
        cmd = args_dict.get("command", "echo 'ok'")
        if any(b in cmd for b in ["rm -rf /", ":(){ :|:& };:", "mkfs"]):
            return {"error": "Command blocked by IBAC security policy"}
        timeout_sec = int(args_dict.get("timeout_sec", 15))
        res = subprocess.run(cmd, shell=True, cwd=workspace, capture_output=True, text=True, timeout=timeout_sec, env=os.environ)
        return {"status": "ok", "exit_code": res.returncode, "stdout": res.stdout, "stderr": res.stderr}
    elif tool_name == "db_query":
        sql = args_dict.get("sql", "").strip()
        if not sql.upper().startswith("SELECT"):
            return {"error": "Only SELECT queries are permitted for safety"}
        con = get_db(write=False)
        with con:
            cur = con.execute(sql)
            rows = [dict(r) for r in cur.fetchall()]
        return {"status": "ok", "rows": rows, "count": len(rows)}
    elif tool_name == "http_fetch":
        url = args_dict.get("url", "")
        headers = get_provider_headers("github")
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = resp.read().decode("utf-8", errors="replace")
        return {"status": "ok", "url": url, "bytes": len(data), "preview": data[:500]}
    else:
        con = get_db(write=False)
        with con:
            row = con.execute("SELECT * FROM capabilities WHERE kind='mcp_server' AND name=?", (tool_name,)).fetchone()
        if row:
            return {"status": "ok", "tool": tool_name, "type": "mcp_server", "status": "simulated_ok", "args": args_dict}
        return {"error": f"Unknown dynamic tool: {tool_name}"}

