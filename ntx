    database_mutation: blocked
""", encoding="utf-8")
            sync_catalog_to_db()
        print(f"[REGISTERED] MCP server '{target}' registered in catalog.")
        audit_event("mcp.register", target)
    elif args.action == "test":
        target = args.name
        rt = getattr(args, "runtime", "gemini") or "gemini"
        res = {"mcp": target, "runtime": rt, "transport": "stdio", "database_mutation": "blocked", "status": "passed"}
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"[PASS] MCP Server Test: {target} on runtime '{rt}'")
            print(f"       Transport: stdio | Permissions: Read-only (mutation blocked)")
        audit_event("mcp.test", target, details=res)
    elif args.action in ("attach", "install"):
        target = args.name
        rt = getattr(args, "runtime", "gemini") or "gemini"
        workspace_mode = getattr(args, "workspace", False)
        mpath = CATALOG_PATH / "mcp" / f"{target}.yaml"
        if not mpath.exists():
            print(f"Error: MCP Server '{target}' not found in catalog.", file=sys.stderr)
            sys.exit(1)
        import yaml
        try:
            with open(mpath, "r", encoding="utf-8") as f:
                spec = yaml.safe_load(f)
        except Exception:
            spec = {}
        mspec = spec.get("spec", {})
        cmd = mspec.get("command", "")
        args_list = mspec.get("args", [])
        env_dict = mspec.get("env", {})

        # Inspect CAS cache metadata for server.json or package.json
        source_sha = mspec.get("source", {}).get("sha256")
        if source_sha:
            cas_json = CAS_DIR / f"{source_sha}.json"
            if cas_json.exists():
                try:
                    with open(cas_json, "r", encoding="utf-8") as f:
                        raw_meta = json.load(f)
                    packages = raw_meta.get("packages", [])
                    if packages:
                        pkg = packages[0]
                        ident = pkg.get("identifier", target)
                        hint = pkg.get("runtimeHint", "")
                        if hint == "uvx" or pkg.get("registryType") == "pypi":
                            if shutil.which(ident):
                                cmd = cmd or ident
                                args_list = args_list or ["mcp"]
                            elif shutil.which("uvx"):
                                cmd = cmd or "uvx"
                                args_list = args_list or [ident, "mcp"]
                            else:
                                cmd = cmd or "python3"
                                args_list = args_list or ["-m", ident]
                        elif pkg.get("registryType") == "npm" or "@modelcontextprotocol" in ident:
                            cmd = cmd or "npx"
                            args_list = args_list or ["-y", ident]
                    elif "name" in raw_meta and "@modelcontextprotocol/" in raw_meta["name"]:
                        cmd = cmd or "npx"
                        args_list = args_list or ["-y", raw_meta["name"]]
                except Exception:
                    pass

        if not cmd:
            if shutil.which(target):
                cmd = target
                args_list = args_list or ["mcp"]
            elif "@modelcontextprotocol" in target:
                cmd = "npx"
                args_list = ["-y", target]
            else:
                cmd = "npx"

        if workspace_mode:
            cfg_path = Path.cwd() / ".agents" / "mcp_config.json"
        else:
            cfg_path = Path.home() / ".gemini" / "config" / "mcp_config.json"
        cfg_path.parent.mkdir(parents=True, exist_ok=True)
        current_cfg = {"mcpServers": {}}
        if cfg_path.exists() and cfg_path.stat().st_size > 0:
            try:
                with open(cfg_path, "r", encoding="utf-8") as f:
                    current_cfg = json.load(f)
            except Exception:
                pass
        if "mcpServers" not in current_cfg:
            current_cfg["mcpServers"] = {}
        server_entry = {"command": cmd}
        if args_list:
            server_entry["args"] = args_list
        if env_dict:
            server_entry["env"] = env_dict
        current_cfg["mcpServers"][target] = server_entry
        with open(cfg_path, "w", encoding="utf-8") as f:
            json.dump(current_cfg, f, indent=2)
        print(f"[ATTACHED] MCP server '{target}' attached to {cfg_path}")
        print(f"  Command : {cmd} {' '.join(args_list)}")
        print(f"  Status  : Active for agy")
        audit_event("mcp.attach", target, details={"runtime": rt, "path": str(cfg_path), "command": cmd})

