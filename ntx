def get_provider_headers(provider: str, host: str = "") -> dict:
    # Scrapling-inspired stealth client headers to bypass CDN/WAF rate blocks
    headers = {
        "User-Agent": f"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/133.0.0.0 Safari/537.36 ntx/{VERSION}",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,application/json,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.9",
        "Sec-Ch-Ua": '"Not(A:Brand";v="99", "Google Chrome";v="133", "Chromium";v="133"',
        "Sec-Ch-Ua-Mobile": "?0",
        "Sec-Ch-Ua-Platform": '"Linux"',
    }
    if provider == "github":
        tok = os.getenv("GITHUB_TOKEN")
        if tok:
            headers["Authorization"] = f"Bearer {tok}"
    elif provider == "gitlab":
        tok = os.getenv("GITLAB_TOKEN")
        if tok:
            headers["PRIVATE-TOKEN"] = tok
    elif provider in ("gitea", "codeberg"):
        if "codeberg" in host.lower():
            tok = os.getenv("CODEBERG_TOKEN") or os.getenv("GITEA_TOKEN")
        else:
            tok = os.getenv("GITEA_TOKEN") or os.getenv("CODEBERG_TOKEN")
        if tok:
            headers["Authorization"] = f"token {tok}"
    elif provider == "gitee":
        tok = os.getenv("GITEE_TOKEN")
        if tok:
            headers["Authorization"] = f"token {tok}"
    return headers

def get_default_branch(provider: str, host: str, repo: str) -> str:
    headers = get_provider_headers(provider, host)
    try:
        if provider == "github":
            if shutil.which("gh"):
                res = subprocess.run(["gh", "repo", "view", repo, "--json", "defaultBranchRef", "--jq", ".defaultBranchRef.name"], capture_output=True, text=True, timeout=5)
                if res.returncode == 0 and res.stdout.strip():
                    return res.stdout.strip()
            url = f"https://api.github.com/repos/{repo}"
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=5) as resp:
                data = json.loads(resp.read().decode("utf-8", errors="ignore"))
                return data.get("default_branch", "main")
        elif provider == "gitlab":
            quoted = urllib.parse.quote_plus(repo)
            url = f"{host}/api/v4/projects/{quoted}"
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=5) as resp:
                data = json.loads(resp.read().decode("utf-8", errors="ignore"))
                return data.get("default_branch", "main")
        elif provider == "gitea":
            url = f"{host}/api/v1/repos/{repo}"
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=5) as resp:
                data = json.loads(resp.read().decode("utf-8", errors="ignore"))
                return data.get("default_branch", "main")
        elif provider == "gitee":
            url = f"https://gitee.com/api/v5/repos/{repo}"
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=5) as resp:
                data = json.loads(resp.read().decode("utf-8", errors="ignore"))
                return data.get("default_branch", "master")
    except Exception:
        pass
    return "main" if provider != "gitee" else "master"

def fetch_provider_tree(provider: str, host: str, repo: str, branch: str) -> list:
    headers = get_provider_headers(provider, host)
    try:
        if provider == "github":
            if shutil.which("gh"):
                res = subprocess.run(["gh", "api", f"repos/{repo}/git/trees/{branch}?recursive=1"], capture_output=True, text=True, timeout=15)
                if res.returncode == 0 and res.stdout.strip():
                    data = json.loads(res.stdout)
                    return [it["path"] for it in data.get("tree", []) if "path" in it]
            url = f"https://api.github.com/repos/{repo}/git/trees/{branch}?recursive=1"
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.loads(resp.read().decode("utf-8", errors="ignore"))
                return [it["path"] for it in data.get("tree", []) if "path" in it]
        elif provider == "gitlab":
            quoted = urllib.parse.quote_plus(repo)
            paths = []
            for p in range(1, 10):
                url = f"{host}/api/v4/projects/{quoted}/repository/tree?recursive=true&per_page=100&page={p}&ref={branch}"
                req = urllib.request.Request(url, headers=headers)
                with urllib.request.urlopen(req, timeout=10) as resp:
                    items = json.loads(resp.read().decode("utf-8", errors="ignore"))
                    if not items or not isinstance(items, list):
                        break
                    for it in items:
                        if it.get("type") == "blob":
                            paths.append(it["path"])
                    if len(items) < 100:
                        break
            return paths
        elif provider == "gitea":
            url = f"{host}/api/v1/repos/{repo}/git/trees/{branch}?recursive=1"
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.loads(resp.read().decode("utf-8", errors="ignore"))
                return [it["path"] for it in data.get("tree", []) if "path" in it]
        elif provider == "gitee":
            url = f"https://gitee.com/api/v5/repos/{repo}/git/trees/{branch}?recursive=1"
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.loads(resp.read().decode("utf-8", errors="ignore"))
                return [it["path"] for it in data.get("tree", []) if "path" in it]
    except Exception:
        pass
    return []

def fetch_provider_file(provider: str, host: str, repo: str, branch: str, path: str):
    headers = get_provider_headers(provider, host)
    try:
        if provider == "github":
            url = f"https://raw.githubusercontent.com/{repo}/{branch}/{path}"
            req = urllib.request.Request(url, headers=headers)
            for attempt in range(2):
                try:
                    with urllib.request.urlopen(req, timeout=10) as resp:
                        return resp.read()
                except urllib.error.HTTPError as e:
                    if e.code in (429, 403) and attempt == 0:
                        delay = parse_retry_after(e.headers)
                        time.sleep(min(delay, 4.0))
                        continue
                    break
                except Exception:
                    break
            if shutil.which("gh"):
                f_res = subprocess.run(["gh", "api", f"repos/{repo}/contents/{path}?ref={branch}", "--jq", ".content"], capture_output=True, text=True, timeout=10)
                if f_res.returncode == 0 and f_res.stdout.strip():
                    return base64.b64decode(f_res.stdout.strip())
        elif provider == "gitlab":
            quoted_repo = urllib.parse.quote_plus(repo)
            quoted_path = urllib.parse.quote_plus(path)
            url = f"{host}/api/v4/projects/{quoted_repo}/repository/files/{quoted_path}/raw?ref={branch}"
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=10) as resp:
                return resp.read()
        elif provider == "gitea":
            url = f"{host}/api/v1/repos/{repo}/raw/{branch}/{path}"
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=10) as resp:
                return resp.read()
        elif provider == "gitee":
            res = subprocess.run(["curl", "-sL", f"https://gitee.com/{repo}/raw/{branch}/{path}"], capture_output=True, timeout=10)
            if res.returncode == 0 and res.stdout:
                return res.stdout
    except Exception:
        pass
    return None

def ingest_repository(target_uri: str, dry_run=False, max_per_kind=100) -> dict:
    parsed = parse_source_uri(target_uri)
    provider = parsed["provider"]
    host = parsed["host"]
    repo = parsed["repo"]
    source_id = parsed["source_id"]

    branch = get_default_branch(provider, host, repo)
    tree = fetch_provider_tree(provider, host, repo, branch)
    if not tree:
        return {"error": f"Failed to fetch tree from {provider}:{repo} at {host} (zero-clone API)", "repo": source_id, "provider": provider}

    synced = {"skills": 0, "mcp": 0, "plugins": 0, "agents": 0, "prompts": 0, "repo": source_id, "provider": provider}

    CAS_DIR.mkdir(parents=True, exist_ok=True)
    for k in ["skills", "mcp", "plugins", "agents", "prompts"]:
        (CATALOG_PATH / k).mkdir(parents=True, exist_ok=True)

    for path in tree:
        if path.startswith(".") and not (".agents/skills" in path or ".claude/skills" in path or ".agents/agents" in path):
            continue

        # 1. Skills: any SKILL.md, skill.yaml, or skill.json
        if (path.endswith("SKILL.md") or path.endswith("skill.yaml") or path.endswith("skill.json")) and not path.endswith(".txt"):
            if synced["skills"] >= max_per_kind:
                continue
            name = Path(path).parent.name
            if name.startswith("_"):
                name = name.lstrip("_")
            if not name or name in (".", "skills"):
                name = Path(path).stem
            if not name or name in (".", "skills", "skill"):
                continue

            raw_bytes = fetch_provider_file(provider, host, repo, branch, path)
            if not raw_bytes:
                continue
            raw_text = raw_bytes.decode("utf-8", errors="ignore")

            sha256 = hashlib.sha256(raw_bytes).hexdigest()
            meta = extract_yaml_frontmatter(raw_text)
            desc = meta.get("description", "")
            if not desc:
                for line in raw_text.splitlines():
                    if line.startswith("# "):
                        desc = line[2:].strip()
                        break
            if not desc:
                desc = f"Imported skill {name} from {provider}:{repo}"
            skill_name = meta.get("name", name).strip()
            skill_name = re.sub(r"[^a-zA-Z0-9_-]", "-", skill_name).lower().strip("-")

            if not dry_run:
                (CAS_DIR / f"{sha256}.md").write_bytes(raw_bytes)
                manifest = f"""apiVersion: nityaksha.simha/v1
kind: Skill
metadata:
  namespace: default
  name: {skill_name}
  version: "1.0.0"
  description: {json.dumps(desc[:200])}
spec:
  source:
    provider: {provider}
    repository: {repo}
    path: {path}
    sha256: {sha256}
  mode: instructions-only
  approval: approved
"""
                (CATALOG_PATH / "skills" / f"{skill_name}.yaml").write_text(manifest, encoding="utf-8")
            synced["skills"] += 1

        # 2. MCP Servers: server.json, glama.json, smithery.yaml, mcp-server.json, mcp.json, or package.json in server dir
        elif (path.endswith("server.json") or path.endswith("glama.json") or path.endswith("smithery.yaml") or path.endswith("mcp-server.json") or (path.endswith("mcp.json") and "test" not in path) or (path.endswith("package.json") and ("src/" in path or "servers/" in path) and ("server-" in path or "@modelcontextprotocol" in path))):
            if synced["mcp"] >= max_per_kind:
                continue
            raw_bytes = fetch_provider_file(provider, host, repo, branch, path)
            if not raw_bytes:
                continue
            try:
                cfg = json.loads(raw_bytes.decode("utf-8", errors="ignore"))
            except Exception:
                cfg = {}

            sha256 = hashlib.sha256(raw_bytes).hexdigest()
            raw_name = cfg.get("name") or Path(path).parent.name
            mcp_name = raw_name.split("/")[-1].replace("@modelcontextprotocol/", "").replace("server-", "")
            mcp_name = re.sub(r"[^a-zA-Z0-9_-]", "-", mcp_name).lower().strip("-")
            mcp_desc = cfg.get("description", f"MCP Server {mcp_name} from {provider}:{repo}")

            if not dry_run:
                (CAS_DIR / f"{sha256}.json").write_bytes(raw_bytes)
                manifest = f"""apiVersion: nityaksha.simha/v1
kind: MCPServer
metadata:
  namespace: default
  name: {mcp_name}
  version: {json.dumps(str(cfg.get("version", "1.0.0")))}
  description: {json.dumps(mcp_desc[:200])}
spec:
  source:
    provider: {provider}
    repository: {repo}
    path: {path}
    sha256: {sha256}
  transport: stdio
  approval: approved
"""
                (CATALOG_PATH / "mcp" / f"{mcp_name}.yaml").write_text(manifest, encoding="utf-8")
            synced["mcp"] += 1

        # 3. Plugins: plugin.json
        elif path.endswith("plugin.json"):
            if synced["plugins"] >= max_per_kind:
                continue
            raw_bytes = fetch_provider_file(provider, host, repo, branch, path)
            if not raw_bytes:
                continue
            try:
                cfg = json.loads(raw_bytes.decode("utf-8", errors="ignore"))
            except Exception:
                continue
            sha256 = hashlib.sha256(raw_bytes).hexdigest()
            pl_name = cfg.get("name", repo.split("/")[-1]).split("/")[-1]
            pl_name = re.sub(r"[^a-zA-Z0-9_-]", "-", pl_name).lower().strip("-")
            pl_desc = cfg.get("description", f"Plugin {pl_name} from {provider}:{repo}")
            if not dry_run:
                (CAS_DIR / f"{sha256}.json").write_bytes(raw_bytes)
                manifest = f"""apiVersion: nityaksha.simha/v1
kind: Plugin
metadata:
  namespace: default
  name: {pl_name}
  version: {json.dumps(str(cfg.get("version", "1.0.0")))}
  description: {json.dumps(pl_desc[:200])}
spec:
  source:
    provider: {provider}
    repository: {repo}
    path: {path}
    sha256: {sha256}
  approval: approved
"""
                (CATALOG_PATH / "plugins" / f"{pl_name}.yaml").write_text(manifest, encoding="utf-8")
            synced["plugins"] += 1

        # 4. Agents: AGENT.md, agent.yaml, agent.json, or inside /agents/ or /personas/
        elif (path.endswith("AGENT.md") or path.endswith("agent.yaml") or path.endswith("agent.json") or (("/agents/" in path or "/personas/" in path or ".agents/agents" in path) and path.endswith(".md"))):
            if synced["agents"] >= max_per_kind:
                continue
            name = Path(path).stem
            if name.upper() == "AGENT":
                name = Path(path).parent.name
            if not name or name in (".", "agents", "personas"):
                continue

            raw_bytes = fetch_provider_file(provider, host, repo, branch, path)
            if not raw_bytes:
                continue
            raw_text = raw_bytes.decode("utf-8", errors="ignore")

            sha256 = hashlib.sha256(raw_bytes).hexdigest()
            meta = extract_yaml_frontmatter(raw_text)
            desc = meta.get("description", "")
            if not desc:
                for line in raw_text.splitlines():
                    if line.startswith("# "):
                        desc = line[2:].strip()
                        break
            if not desc:
                desc = f"Imported agent {name} from {provider}:{repo}"
            agent_name = meta.get("name", name).strip()
            agent_name = re.sub(r"[^a-zA-Z0-9_-]", "-", agent_name).lower().strip("-")

            if not dry_run:
                (CAS_DIR / f"{sha256}.md").write_bytes(raw_bytes)
                manifest = f"""apiVersion: nityaksha.simha/v1
kind: Agent
metadata:
  namespace: default
  name: {agent_name}
  version: "1.0.0"
  description: {json.dumps(desc[:200])}
spec:
  source:
    provider: {provider}
    repository: {repo}
    path: {path}
    sha256: {sha256}
  approval: approved
"""
                (CATALOG_PATH / "agents" / f"{agent_name}.yaml").write_text(manifest, encoding="utf-8")
            synced["agents"] += 1

        # 5. Prompts: PROMPT.md, prompt.yaml, prompt.json, /prompts/*.md, or patterns/*/system.md
        elif (path.endswith("PROMPT.md") or path.endswith("prompt.yaml") or path.endswith("prompt.json") or ("/prompts/" in path and (path.endswith(".md") or path.endswith(".yaml") or path.endswith(".txt"))) or ("patterns/" in path and path.endswith("system.md"))):
            if synced["prompts"] >= max_per_kind:
                continue
            name = Path(path).stem
            if name.upper() in ("PROMPT", "SYSTEM"):
                name = Path(path).parent.name
            if not name or name in (".", "prompts", "patterns"):
                continue

            raw_bytes = fetch_provider_file(provider, host, repo, branch, path)
            if not raw_bytes:
                continue
            raw_text = raw_bytes.decode("utf-8", errors="ignore")

            sha256 = hashlib.sha256(raw_bytes).hexdigest()
            meta = extract_yaml_frontmatter(raw_text)
            desc = meta.get("description", "")
            if not desc:
                for line in raw_text.splitlines():
                    if line.startswith("# "):
                        desc = line[2:].strip()
                        break
            if not desc:
                desc = f"Imported prompt {name} from {provider}:{repo}"
            prompt_name = meta.get("name", name).strip()
            prompt_name = re.sub(r"[^a-zA-Z0-9_-]", "-", prompt_name).lower().strip("-")

            if not dry_run:
                (CAS_DIR / f"{sha256}.md").write_bytes(raw_bytes)
                manifest = f"""apiVersion: nityaksha.simha/v1
kind: Prompt
metadata:
  namespace: default
  name: {prompt_name}
