def parse_simple_yaml(path: Path) -> dict:
    data = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
        current_list = None
        for line in lines:
            line_s = line.strip()
            if not line_s or line_s.startswith("#"):
                continue
            if line_s.startswith("- ") and current_list:
                data[current_list].append(line_s[2:].strip().strip('"\''))
                continue
            if ":" in line:
                k, v = line.split(":", 1)
                k = k.strip()
                v = v.strip().strip('"\'')
                if not v:
                    current_list = k
                    data[k] = []
                else:
                    current_list = None
                    data[k] = v
    except Exception:
        pass
    return data

def extract_yaml_frontmatter(content: str) -> dict:
    meta = {}
    if content.startswith("---"):
        parts = content.split("---", 2)
        if len(parts) >= 3:
            fm = parts[1]
            for line in fm.splitlines():
                line = line.strip()
                if ":" in line and not line.startswith("#"):
                    k, v = line.split(":", 1)
                    meta[k.strip()] = v.strip().strip('"\'')
    return meta

def load_policy():
    data = {}
    if CONFIG_PATH.exists():
        data = parse_simple_yaml(CONFIG_PATH)
    return data

