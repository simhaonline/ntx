def cmd_catalog(args):
    con = get_db()
    if args.action == "search":
        q = (args.query or "").lower().strip()
        search_terms = q.split()
        kind_filter = args.kind.rstrip("s") if getattr(args, "kind", None) else None
        if kind_filter == "mcp_server":
            kind_filter = "mcp"
        cur = con.execute("SELECT * FROM capabilities")
        rows = cur.fetchall()
        matched = []
        for r in rows:
            if kind_filter and r["kind"] != kind_filter and r["kind"] != kind_filter.rstrip("s"):
                continue
            haystack = f"{r['name']} {r['description'] or ''} {r['kind']} {r['namespace']}".lower()
            if not search_terms or all(t in haystack for t in search_terms):
                matched.append(dict(r))
        if args.json:
            print(json.dumps(matched, indent=2))
        else:
            print(f"Capability Catalog Search for '{args.query or '*'}' ({len(matched)} matches):")
            print("-" * 90)
            for m in matched:
                print(f"  [{m['kind']:<10}] {m['name']:<28} v{m['version']:<6} {m['description'][:46]}")
            print("-" * 90)
    elif args.action == "inspect":
        raw_target = args.query.strip()
        target = raw_target.split("/")[-1]
        cur = con.execute("SELECT * FROM capabilities WHERE name=? OR id=? OR id=?", (target, target, f"skill:{target}"))
        row = cur.fetchone()
