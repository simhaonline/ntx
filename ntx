  approval: approved
"""
                (CATALOG_PATH / "prompts" / f"{prompt_name}.yaml").write_text(manifest, encoding="utf-8")
            synced["prompts"] += 1

    con = get_db(write=True)
    with con:
        con.execute(
            "INSERT INTO sources (id, provider, repository, status, last_synced_at) VALUES (?, ?, ?, 'active', datetime('now')) ON CONFLICT(id) DO UPDATE SET last_synced_at=datetime('now')",
            (source_id, provider, repo)
        )
    sync_catalog_to_db()
    return synced

def search_github_repositories(query: str, limit: int = 5) -> list:
    headers = get_provider_headers("github")
    headers["Accept"] = "application/vnd.github.v3+json"
    url = f"https://api.github.com/search/repositories?q={urllib.parse.quote(query)}&per_page={limit}"
    req = urllib.request.Request(url, headers=headers)
    for attempt in range(2):
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = json.loads(resp.read().decode("utf-8", errors="ignore"))
                return [it["full_name"] for it in data.get("items", []) if "full_name" in it]
        except urllib.error.HTTPError as e:
            if e.code in (429, 403) and attempt == 0:
                delay = parse_retry_after(e.headers)
                time.sleep(min(delay, 5.0))
                continue
            break
        except Exception:
            break
    return []

