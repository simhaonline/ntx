def parse_retry_after(headers) -> float:
    """Parse Retry-After or RateLimit reset header inspired by Scrapling throttle engine."""
    value = ""
    for k, v in headers.items():
        if k.lower() == "retry-after":
            value = v.strip()
            break
    if not value:
        for k, v in headers.items():
            if k.lower() in ("x-ratelimit-reset", "ratelimit-reset"):
                try:
                    reset_ts = float(v.strip())
                    now_ts = datetime.now(timezone.utc).timestamp()
                    return max(reset_ts - now_ts, 1.0)
                except Exception:
                    pass
        return 2.0
    try:
        return max(float(value), 1.0)
    except ValueError:
        try:
            import email.utils
            dt = email.utils.parsedate_to_datetime(value)
            return max((dt - datetime.now(timezone.utc)).total_seconds(), 1.0)
        except Exception:
            return 2.0

