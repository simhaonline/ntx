def parse_source_uri(raw_uri: str) -> dict:
    raw = raw_uri.strip()
    provider = None
    for p in ["github", "gitlab", "gitea", "gitee", "codeberg"]:
        if raw.startswith(f"{p}:"):
            provider = p
            raw = raw[len(f"{p}:"):]
            break

    if raw.startswith("http://") or raw.startswith("https://"):
        u = urllib.parse.urlparse(raw)
        host = f"{u.scheme}://{u.netloc}"
        path = u.path.strip("/")
        if path.endswith(".git"):
            path = path[:-4]
        if not provider:
            domain = u.netloc.lower()
            if "gitlab" in domain:
                provider = "gitlab"
            elif "gitea" in domain or "codeberg" in domain or "forgejo" in domain:
                provider = "gitea"
            elif "gitee" in domain:
                provider = "gitee"
            elif "github" in domain:
                provider = "github"
            else:
                provider = "github"
        repo = path
    else:
        path = raw.strip("/")
        if path.endswith(".git"):
            path = path[:-4]
        if not provider:
            provider = "github"
        repo = path
        if provider == "github":
            host = "https://github.com"
        elif provider == "gitlab":
            host = "https://gitlab.com"
        elif provider in ("gitea", "codeberg"):
            host = "https://codeberg.org" if (provider == "codeberg" or "codeberg" in raw or "codeberg" in repo) else "https://gitea.com"
            provider = "gitea"
        elif provider == "gitee":
            host = "https://gitee.com"
        else:
            host = "https://github.com"

    resolved_provider = "gitea" if provider == "codeberg" else provider
    return {
        "provider": resolved_provider,
        "host": host,
        "repo": repo,
        "source_id": f"{resolved_provider}:{repo}" if resolved_provider != "github" else repo
    }

