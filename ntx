            if "error" not in res:
                totals["skills"] += res["skills"]
                totals["agents"] += res["agents"]
                totals["mcp"] += res["mcp"]
                totals["plugins"] += res["plugins"]
                totals["prompts"] += res["prompts"]
                totals["sources"] += 1
                print(f"  [SYNCED] [{res['provider']:<8}] {res['repo']:<35} -> {res['skills']} skills, {res['agents']} agents, {res['mcp']} mcp, {res['plugins']} plugins, {res['prompts']} prompts")
            else:
                print(f"  [WARN]   [{prov:<8}] {repo:<35} -> {res['error']}")
        sync_catalog_to_db()
        print("\nCatalog Sync Completed.")
        cmd_catalog(argparse.Namespace(action="stats", json=False))
        audit_event("catalog.sync", "all", details=totals)
    elif args.action in ("harvest", "discover"):
        dry_run = getattr(args, "dry_run", False)
        limit_per_topic = getattr(args, "limit", 5) or 5
        curated_only = getattr(args, "curated_only", False)
        specific_query = getattr(args, "query", None)

        print("================================================================================")
        print("             ntx UNIVERSAL CAPABILITY HARVESTER & DISCOVERY ENGINE              ")
        print("     Zero-Clone Policy | Content-Addressable Storage | SQLite Registry SoT      ")
        print("================================================================================")

        # 1. Existing active sources from SQLite DB
        cur = con.execute("SELECT id, provider, repository FROM sources WHERE status='active'")
        target_map = {}
        for r in cur.fetchall():
            target_map[r["id"]] = f"{r['provider']}:{r['repository']}" if r["provider"] != "github" else r["repository"]

        # 2. Top-tier curated repositories
        for cr in PREMIER_CURATED_SOURCES:
            target_map[cr] = cr

        # 3. Dynamic GitHub Discovery
        if not curated_only:
            topics_to_search = [specific_query] if specific_query else DISCOVERY_TOPICS
            print(f"[*] Discovering top repositories across {len(topics_to_search)} ecosystem topics...")
            for t in topics_to_search:
                discovered = search_github_repositories(t, limit=limit_per_topic)
                print(f"    Topic [{t[:35]:<35}] -> found {len(discovered)} repos")
                for d in discovered:
                    target_map[d] = d
                time.sleep(0.5)

        targets = list(target_map.values())
        print(f"\n[*] Harvesting targeted capability assets across {len(targets)} repositories...")
        print("-" * 80)

        checkpoint = load_harvest_checkpoint()
        force = getattr(args, "force", False)

        totals = {"skills": 0, "agents": 0, "mcp": 0, "plugins": 0, "prompts": 0, "repos_scanned": 0, "errors": 0}
        for i, target in enumerate(targets, 1):
            if not force and target in checkpoint and (time.time() - checkpoint[target].get("timestamp", 0) < 43200):
                cached = checkpoint[target].get("result", {})
                totals["repos_scanned"] += 1
                totals["skills"] += cached.get("skills", 0)
                totals["agents"] += cached.get("agents", 0)
                totals["mcp"] += cached.get("mcp", 0)
                totals["plugins"] += cached.get("plugins", 0)
                totals["prompts"] += cached.get("prompts", 0)
                print(f"[{i:02d}/{len(targets):02d}] Harvesting {target} ... CACHED (+{cached.get('skills',0)} skills, +{cached.get('agents',0)} agents, +{cached.get('mcp',0)} mcp)", flush=True)
                continue

            print(f"[{i:02d}/{len(targets):02d}] Harvesting {target} ...", end=" ", flush=True)
            res = ingest_repository(target, dry_run=dry_run)
            if "error" not in res:
                totals["skills"] += res["skills"]
                totals["agents"] += res["agents"]
                totals["mcp"] += res["mcp"]
                totals["plugins"] += res["plugins"]
                totals["prompts"] += res["prompts"]
                totals["repos_scanned"] += 1
                checkpoint[target] = {"timestamp": time.time(), "result": res}
                save_harvest_checkpoint(checkpoint)
                print(f"OK (+{res['skills']} skills, +{res['agents']} agents, +{res['mcp']} mcp, +{res['plugins']} plugins, +{res['prompts']} prompts)", flush=True)
            else:
                totals["errors"] += 1
                print(f"SKIPPED ({res['error'][:40]})", flush=True)
            time.sleep(0.5)

        sync_catalog_to_db()
        print("-" * 80, flush=True)
        print("Harvest Completed.", flush=True)
        cmd_catalog(argparse.Namespace(action="stats", json=False))
        audit_event("catalog.harvest", "ecosystem", details=totals)
    elif args.action == "stats":
        cur = con.execute("SELECT kind, count(*) as cnt FROM capabilities GROUP BY kind")
        counts = {r["kind"]: r["cnt"] for r in cur.fetchall()}
        db_size = DB_PATH.stat().st_size if DB_PATH.exists() else 0
        cur_src = con.execute("SELECT count(*) as cnt FROM sources")
        src_cnt = cur_src.fetchone()["cnt"]
        res = {"entity_counts": counts, "database_bytes": db_size, "sources_active": src_cnt}
        if args.json:
            print(json.dumps(res, indent=2))
        else:
