                print(f"  {t['touched_at'][:19]} | {t['session_id']:<16} | {t['action'].upper():<5} | {t['summary']:<12} | {t['path']}")

def cmd_diff(args):
    con = get_db()
    dir_a = Path(args.dirA) if getattr(args, "dirA", None) else None
    dir_b = Path(args.dirB) if getattr(args, "dirB", None) else None

    # Default to catalog vs current workspace .agents if not given
    if not dir_a:
        dir_a = Path("/opt/nityaksha/catalog")
    if not dir_b:
        dir_b = Path.cwd() / ".agents"

    print(f"Agent Authority Differ:")
    print(f"  Base Path   (A): {dir_a}")
    print(f"  Target Path (B): {dir_b}")
    print("=" * 80)

    def scan_caps(base_dir):
        caps = {"skills": set(), "agents": set(), "rules": set(), "mcp": set()}
        if not base_dir.exists():
            return caps
        s_dir = base_dir / "skills"
        if s_dir.exists():
            for p in s_dir.iterdir():
                if p.is_dir() or p.suffix in (".md", ".yaml"):
                    caps["skills"].add(p.stem)
        a_dir = base_dir / "agents"
        if a_dir.exists():
            for p in a_dir.iterdir():
                if p.is_dir() or p.suffix in (".md", ".yaml"):
                    caps["agents"].add(p.stem)
        r_dir = base_dir / "rules"
        if r_dir.exists():
            for p in r_dir.iterdir():
                if p.suffix == ".md":
                    caps["rules"].add(p.stem)
        m_file = base_dir / "mcp_config.json"
        if m_file.exists():
            try:
                data = json.loads(m_file.read_text(encoding="utf-8"))
                for s in data.get("mcpServers", {}).keys():
                    caps["mcp"].add(s)
            except Exception:
                pass
        return caps

    caps_a = scan_caps(dir_a)
    caps_b = scan_caps(dir_b)

    has_diff = False
    for kind in ["skills", "agents", "rules", "mcp"]:
        added = sorted(list(caps_b[kind] - caps_a[kind]))
        removed = sorted(list(caps_a[kind] - caps_b[kind]))
        if added or removed:
            has_diff = True
            print(f"  [{kind.upper()}] Authority Delta:")
            for item in added:
                print(f"    [+] NEW AUTHORITY GRANTED: {item}")
            for item in removed:
                print(f"    [-] AUTHORITY REVOKED:     {item}")
    if not has_diff:
        print("  Zero authority delta detected between scopes.")
    audit_event("authority.diff", str(dir_b))

def cmd_gate(args):
    action = args.action
    if action == "eval":
        tool = getattr(args, "tool", "") or ""
        intent = getattr(args, "intent", "") or ""
        tool_args = getattr(args, "tool_args", "") or ""

        violations = []
        s_tool = tool.lower()
        s_intent = intent.lower()
        s_args = tool_args.lower()

        if any(w in s_args or w in s_tool for w in ["docker.sock", "/var/run/docker.sock"]):
            violations.append("Violation: Direct host docker socket exposure is strictly prohibited")
        if any(w in s_intent or w in s_tool for w in ["live_order", "live order", "place_order", "place order", "broker", "broker_buy", "broker_sell", "execute_order"]):
            violations.append("Violation: Financial broker order execution is prohibited by default governance policy")
        if any(w in s_args for w in ["rm -rf /", "mkfs", "> /dev/sd", "dd if=/dev/zero"]):
            violations.append("Violation: Destructive operating system corruption command detected")

        decision = "REJECTED" if violations else "PERMITTED"
        trace_record = {
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "tool": tool,
            "intent": intent,
            "args": tool_args,
            "decision": decision,
            "severity": "log_and_replan",
            "violations": violations,
            "policy": "/etc/nityaksha/policy.yaml"
        }

        traces_path = Path("/var/lib/nityaksha/audit/traces.jsonl")
        traces_path.parent.mkdir(parents=True, exist_ok=True)
        with open(traces_path, "a", encoding="utf-8") as f:
            f.write(json.dumps(trace_record) + "\n")

        if args.json:
            print(json.dumps(trace_record, indent=2))
        else:
            status_tag = "[PERMITTED]" if decision == "PERMITTED" else "[REJECTED]"
            print(f"Intent-Based Access Control (IBAC) Evaluation:")
            print(f"  Tool     : {tool}")
            print(f"  Intent   : {intent}")
            print(f"  Decision : {status_tag}")
            if violations:
                print("  Severity : Log and allow re-plan (non-fatal, session preserved for re-planning)")
                for v in violations:
                    print(f"  Rule     : {v}")
                print("  Guidance : Action prohibited by policy boundary. Model may adjust arguments or select a compliant tool.")
            else:
                print("  Security : Verified against policy boundaries (0 violations, trace committed).")
        audit_event("gate.eval", tool, status="success" if decision == "PERMITTED" else "blocked", details=trace_record)
    elif action == "trace":
        traces_path = Path("/var/lib/nityaksha/audit/traces.jsonl")
        if not traces_path.exists():
            print("  No decision traces recorded yet.")
            return
        lines = traces_path.read_text(encoding="utf-8").strip().splitlines()
        print(f"Recent Action Decision Traces (Last {min(10, len(lines))} of {len(lines)}):")
        print("=" * 80)
        for line in lines[-10:]:
            try:
                rec = json.loads(line)
                print(f"  {rec.get('timestamp')[:19]} | {rec.get('decision'):<10} | Tool: {rec.get('tool'):<15} | Intent: {rec.get('intent')[:40]}")
            except Exception:
                pass

